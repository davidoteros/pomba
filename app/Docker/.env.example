# --- POSTGRES CONFIG ---
POSTGRES_DB=mydb
POSTGRES_USER=admin
POSTGRES_PASSWORD=pon_aqui_tu_password_segura

# --- DJANGO CONFIG ---
DB_NAME=mydb
DB_USER=admin
DB_PASSWORD=pon_aqui_tu_password_segura
DB_HOST=db
DB_PORT=5432
DJANGO_SECRET_KEY=genera_una_clave_larga_y_aleatoria
DEBUG=True

# --- GARAGE (S3) CONFIG ---
# El RPC lo generamos cuando desplegamos Garage
GARAGE_RPC_SECRET=tu_rpc_secret_generado
AWS_ACCESS_KEY_ID=tu_access_key
AWS_SECRET_ACCESS_KEY=tu_secret_key
AWS_STORAGE_BUCKET_NAME=pomba-app
AWS_S3_ENDPOINT_URL=http://garage:3900

# --- LIMITES DE SUBIDA ---
# Unica fuente de verdad del tamanio maximo por fichero: la lee nginx (envsubst la
# mete en client_max_body_size) y tambien Django, que la convierte a bytes. Se
# escribe con sufijo de nginx (k/m/g) porque es el formato que necesita su config.
POMBA_LIMITE_FICHERO=2g
# Tope del /api/, que solo recibe JSON y la foto de perfil (los ficheros van por :3900).
POMBA_LIMITE_API=25m

# Cuota total por usuario, en bytes. Multiplicada por el numero de usuarios tiene
# que caber en el disco del servidor, o no protege de nada.
CUOTA_USUARIO_BYTES=21474836480

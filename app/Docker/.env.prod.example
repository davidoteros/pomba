# Copiar este fichero a .env.prod y rellenar con los valores reales.


# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_SETTINGS_MODULE=core.settings.production
EXPONER_API_SCHEMA=false

# PostgreSQL
POSTGRES_DB=pomba_db
POSTGRES_USER=pomba_user
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-segura
DB_NAME=pomba_db
DB_USER=pomba_user
DB_PASSWORD=cambia-esto-por-una-contraseña-segura
DB_HOST=db
DB_PORT=5432

# Garage S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=pomba-app
AWS_S3_ENDPOINT_URL=http://garage:3900
AWS_S3_REGION_NAME=garage
GARAGE_RPC_SECRET=cambia-esto-por-un-secreto-largo
# URL pública para presigned URLs — el navegador sube directo a este endpoint
GARAGE_PUBLIC_URL=https://pomba.me:3900

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# --- LIMITES DE SUBIDA ---
# Unica fuente de verdad del tamanio maximo por fichero: la lee nginx (envsubst la
# mete en client_max_body_size) y tambien Django, que la convierte a bytes. Se
# escribe con sufijo de nginx (k/m/g) porque es el formato que necesita su config.
POMBA_LIMITE_FICHERO=2g
# Tope del /api/, que solo recibe JSON y la foto de perfil (los ficheros van por :3900).
POMBA_LIMITE_API=25m

# Cuota total por usuario, en bytes. Multiplicada por el numero de usuarios tiene
# que caber en el disco del servidor, o no protege de nada.
CUOTA_USUARIO_BYTES=21474836480
